// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  engineType = "client"
}
datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  password     String?
  googleId     String? @unique
  phone        String?
  image        String?
  imagePublicId String? 
  resetTokens   String?
  resetTokenExpiry DateTime?
  refreshToken RefreshToken[]
  pushSubscriptions PushSubscription[]
  createdAt    DateTime      @default(now())
  clients      Client[]
  updatedAt    DateTime      @updatedAt
  @@map("users")
}

model RefreshToken {
  id          String   @id @default(uuid())
  hashedToken String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  revoked     Boolean  @default(false)
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  @@map("refreshTokens")
}

model Client{
  id           String           @id @default(uuid())
  name         String
  phone        String
  address      String?
  email        String?
  gender       Gender
  tailor       User    @relation(fields: [tailorId], references: [id], onDelete: Cascade)
  tailorId     String
  measurements Measurement[]
  image        String?
  imagePublicId String? 
  orders       Order[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([tailorId])
  @@index([phone])
  @@map("clients")
  
}
enum Gender {
  MALE
  FEMALE
}

model Measurement {
  id           String           @id @default(uuid())
  title        String
  unit         Unit     @default(INCHES)
  data         Json
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("measurements")
}
enum Unit {
  CM
  INCHES
}

model Order {
  id          String      @id @default(uuid())
  clientId    String
  image       String?
  imagePublicId String? 
  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  status      OrderStatus @default(PENDING)
  dueDate     DateTime?
  totalAmount Float?
  notes       String?
  reminders   OrderReminder[]
  emailReminders EmailOrderReminder[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([clientId, status])
  @@map("orders")
}

enum OrderStatus {
  PENDING
  CUTTING
  SEWING
  FITTING
  COMPLETED
  DELIVERED
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reminders OrderReminder[]

  @@index([userId])
}

model OrderReminder {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  dueDate   DateTime
  kind      String
  sentAt    DateTime @default(now())

  @@unique([orderId, dueDate, kind, subscriptionId])
}

model EmailOrderReminder {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dueDate   DateTime
  kind      String
  recipient String
  sentAt    DateTime @default(now())

  @@unique([orderId, dueDate, kind, recipient])
}
