FROM node:20

RUN apt-get update -y && apt-get install -y openssl

WORKDIR /app

# 1. Copy package files and TypeScript config
COPY package*.json tsconfig.json ./

# 2. Install dependencies
RUN npm install

# 3. Copy application source code (including prisma/ and prisma.config.ts)
COPY . .

# 4. Generate Prisma client from the single copied source
RUN npx prisma generate

EXPOSE 8000

CMD ["npm", "run", "dev"]