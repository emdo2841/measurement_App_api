        "bcryptjs": "^3.0.3",
        "cloudinary": "^2.10.0",
        "compression": "^1.8.1",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^4.17.1",
        "express-rate-limit": "^8.6.2",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "multer": "^2.2.0",
        "nodemailer": "^9.0.5",
        "path": "^0.12.7",
        "pg": "^8.22.0",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "rate-limit-redis": "^6.0.1",
