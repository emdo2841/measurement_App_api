        "@types/nodemailer": "^8.0.1",
        "@types/pg": "^8.20.0",
        "@types/pino-http": "^5.8.4",
        "@types/supertest": "^7.2.1",
        "nodemon": "^3.1.14",
        "pino-pretty": "^13.1.3",
        "prisma": "^7.9.1",
